---
pagination:
  data: collections.resumes
  size: 1
  alias: resume
permalink: "{{ resume.slug }}/index.html"
eleventyExcludeFromCollections: true
---
{% set profile = resume.profileData %}
{% set fieldStyles = {
  age: { id: "aging", icon: "happy-birthday", label: "Birthday", attribution: "https://www.flaticon.com/fr/icone-gratuite/happy-birthday_8675274?term=birthday&page=1&position=5&origin=search&related_id=8675274" },
  mobility: { id: "place", icon: "planete-terre", label: "Earth", attribution: "https://www.flaticon.com/fr/icone-gratuite/planete-terre_921490?term=terre&page=1&position=1&origin=tag&related_id=921490" },
  relocation: { icon: "maps-and-flags", label: "Pin", attribution: "https://www.flaticon.com/free-icons/pin" },
  nationality: { id: "civility", icon: "france", label: "France", attribution: "https://www.flaticon.com/free-icons/france" },
  phone: { icon: "appel-telephonique", label: "Phone", attribution: "https://www.flaticon.com/fr/icones-gratuites/telephone" },
  email: { id: "e-mail", icon: "email", label: "Email", attribution: "https://www.flaticon.com/fr/icone-gratuite/email_3059474?term=email&page=1&position=7&origin=tag&related_id=3059474" },
  linkedin_url: { id: "linkedin", icon: "linkedin", label: "LinkedIn", attribution: "https://www.flaticon.com/fr/icone-gratuite/sociale_14064516?term=linkedin&page=1&position=1&origin=tag&related_id=14064516" },
  github_url: { id: "github", icon: "github", label: "GitHub", attribution: "https://www.flaticon.com/fr/icone-gratuite/github_4926624?term=github&page=1&position=1&origin=tag&related_id=4926624" },
  pdf_label: { id: "resume-files", icon: "download", label: "Download", attribution: "https://www.flaticon.com/free-icon/download_724933" }
} %}
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <base target="_blank" />
    {% for key in ["description", "keywords"] %}
    {% if profile[key] %}<meta name="{{ key }}" content="{{ profile[key] }}">{% endif %}
    {% endfor %}
    <link rel="stylesheet" href="../styles.css" />
    <link rel="icon" href="../assets/planete-terre.png" />
    <title>{{ profile.document_title or profile.name or resume.slug }}</title>
  </head>
  <body theme="navy" mapping="pdf">
    <div id="left-panel">
      {% if profile.photo %}
      <div id="photo">
        <img src="../{{ profile.photo }}" alt="Portrait{% if profile.name %} of {{ profile.name }}{% endif %}" />
      </div>
      {% endif %}
      {% if resume.fields.length %}
      <div id="personal-data">
        {% for key, value in resume.fields %}
        {% set style = fieldStyles.nationality if key == "work_permit" else fieldStyles[key] %}
        {% set linkKey = key.slice(0, -4) if key.endsWith("_url") else key %}
        <div id="{{ style.id or linkKey }}"{% if not style %} class="plain-field"{% endif %}>
          {% if style.icon %}
          <a target="_blank" class="mention" aria-label="{{ style.label }} icon attribution" href="{{ style.attribution }}">
            <img src="../assets/{{ style.icon }}.png" alt="" />
          </a>
          {% endif %}
          {% if key.endsWith("_url") %}
          <a target="_blank" class="link" href="{{ value }}">{{ profile[linkKey + "_label"] or style.label or (linkKey | replace("_", " ") | capitalize) }}</a>
          {% elif key == "pdf_label" %}
          <a target="_blank" class="link" href="../generated/{{ resume.slug }}.pdf">{{ value }}</a>
          {% else %}
          <span>{% if not style %}{{ key | replace("_", " ") | capitalize }}: {% endif %}{{ value }}{% if key == "nationality" and profile.work_permit %}<br />{{ profile.work_permit }}{% endif %}</span>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% for section in [
        { id: "languages", entry: resume.languages, title: "Languages" },
        { id: "skills", entry: resume.skills, title: "Skills" }
      ] %}
      {% if section.entry.content | trim %}
      <svg class="h-line" aria-hidden="true"><rect /></svg>
      <div id="{{ section.id }}">
        <div class="header">{{ section.entry.data.title or section.title }}</div>
        <div class="body">{{ section.entry.content | safe }}</div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    <div id="right-panel">
      {% if profile.name or profile.title %}
      <div class="header">
        {% for key in ["name", "title"] %}
        {% if profile[key] %}<div id="{{ key }}">{{ profile[key] }}</div>{% endif %}
        {% endfor %}
      </div>
      {% endif %}
      <div class="body">
        {% for section in [
          { id: "professional-summary", title: resume.summary.data.title or "Professional summary", entries: [resume.summary] },
          { id: "professional-experiences", title: profile.experience_title or "Professional experiences", entries: resume.experience, heading: "period" },
          { id: "projects", title: profile.projects_title or "Projects", entries: resume.projects, heading: "title" },
          { id: "educations", title: profile.education_title or "Educations", entries: resume.education, heading: "period" },
          { id: "centers-of-interest", title: resume.interests.data.title or "Centers of interest", entries: [resume.interests] }
        ] %}
        {% set entries = section.entries | selectattr("content") %}
        {% if entries.length %}
        <div id="{{ section.id }}">
          <div class="header">{{ section.title }}</div>
          <div class="body">
            {% for entry in entries %}
            {% if section.heading %}
            <div class="list-element">
              {% if entry.data[section.heading] %}<div class="content-title">{{ entry.data[section.heading] }}</div>{% endif %}
              <div class="entry-content">{{ entry.content | safe }}</div>
            </div>
            {% else %}
            {{ entry.content | safe }}
            {% endif %}
            {% endfor %}
          </div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </body>
</html>
