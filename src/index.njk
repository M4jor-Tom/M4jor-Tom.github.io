---
permalink: index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tom Vautray — Résumés</title>
    <link rel="icon" href="assets/planete-terre.png" />
    <style>
      body { max-width: 40rem; margin: 4rem auto; padding: 0 1.5rem; font-family: Arial, sans-serif; line-height: 1.6; color: #103056; }
      ul { padding: 0; list-style: none; }
      li { margin: 1rem 0; padding: 1rem; background: #f0f4f8; border-radius: .5rem; }
      a { color: #17499b; text-underline-offset: .2em; }
      a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
      .resume-name { display: block; font-size: 1.25rem; text-transform: capitalize; overflow-wrap: anywhere; }
    </style>
  </head>
  <body>
    <main>
      <h1>Tom Vautray</h1>
      <p>Résumés — view online or download a PDF.</p>
      <ul>
        {% for resume in collections.resumes %}
        {% set label = resume.slug | replace("_", " ") | replace("-", " ") %}
        <li>
          <a class="resume-name" href="{{ resume.slug }}/">{{ label }}</a>
          <a href="generated/{{ resume.slug }}.pdf" download aria-label="Download {{ label }} résumé as PDF">Download PDF</a>
        </li>
        {% endfor %}
      </ul>
    </main>
  </body>
</html>
